# PassportIQ — environment template. Copy to .env and fill in. Never commit .env.

# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://passportiq:passportiq_local_dev@localhost:5432/passportiq?schema=public"

# Session lifetime in hours (server-enforced expiry; cookie maxAge matches).
SESSION_TTL_HOURS="168"

# Name of the session cookie.
SESSION_COOKIE_NAME="piq_session"

# Password for the seeded demo user (Jordan Carter). Dev/demo only.
# The seed script refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="demo-passportiq-1"

# RESERVED — field-level encryption key slot (AES-256-GCM, base64, 32 bytes).
# Milestone 1 stores no field-encrypted data; see docs/04-SECURITY-MODEL.md.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""
